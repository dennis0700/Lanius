# Example environment file for the lanius systemd service.
# Copy to /opt/lanius/lanius.env, fill in real values, then:
#   chmod 600 /opt/lanius/lanius.env
#   chown lanius:lanius /opt/lanius/lanius.env
#
# See docs/configuration.md in the repo for the full, authoritative list.

# Required: bearer key clients must present to Lanius. Must not be empty.
PROXY_API_KEY=change-me-to-a-long-random-value

# AWS region used to build Kiro/OIDC endpoint URLs.
KIRO_REGION=us-east-1

# Bind address/port for the gateway's HTTP server.
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Credentials (pick one source). Lanius does not create/log into these
# itself — it only reads a file that already exists, produced elsewhere by
# kiro-cli's own `login` flow or the Kiro desktop app. There is no single
# fixed path for either; the two commented examples below are just
# kiro-cli's own default locations (see `kiro-cli`'s docs) — use whatever
# path actually holds your credentials on this host (e.g. after copying a
# file over from a machine where you're already logged in, or running
# `kiro-cli login` directly on this server).
# REFRESH_TOKEN=...
# PROFILE_ARN=...
# KIRO_CREDS_FILE=~/.aws/sso/cache/kiro-auth-token.json
# KIRO_CLI_DB_FILE=~/.local/share/kiro-cli/data.sqlite3

LOG_LEVEL=INFO
